# Kova Sun Shade — Apache rules for correct Google crawling
#
# Fixes three problems found on the live server:
#   1. www.kovasunshade.com served the site at 200 (duplicate content)
#   2. every page URL 301-redirected to a trailing-slash version
#      (/roller -> /roller/), while the sitemap, canonical and hreflang
#      tags all use the no-slash form
#   3. unknown URLs returned 200 (soft 404) instead of a real 404

Options -Indexes -MultiViews
DirectorySlash Off
RewriteEngine On

# --- One canonical host: https:// without www ---
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://kovasunshade.com%{REQUEST_URI} [R=301,L]

# --- /page/ -> /page (matches the URLs in sitemap.xml and canonical tags) ---
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# --- Serve the pre-rendered page for /page without any redirect ---
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ /$1/index.html [L]

# --- Unknown URLs: real 404 status; the app shell renders the NotFound page ---
ErrorDocument 404 /index.html

# --- Caching: keep deploys from 404-ing on stale hashed asset URLs ---
# Vite fingerprints every file it emits under /assets/ (app-Bx7f2k.js, etc.),
# so those are safe to cache forever. Every index.html (root plus one per
# pre-rendered route, e.g. /roller/index.html) references whichever asset
# hashes existed at build time, so it must never be cached — otherwise a
# browser holding an old cached index.html keeps requesting JS/CSS files
# that no longer exist after the next deploy, and users get a blank screen.
<IfModule mod_headers.c>
  # Never cache the HTML shell, root or per-route
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Long-term immutable caching for everything under /assets/
  SetEnvIf Request_URI "^/assets/" IS_HASHED_ASSET
  Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET
</IfModule>
